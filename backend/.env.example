# ── Database ─────────────────────────────────────────────────────────────────
# Format: mongodb+srv://<user>:<password>@cluster.mongodb.net/mydb
# ✅ Use a dedicated DB user with least-privilege access (read/write on one DB only).
MONGO_URI=mongodb://localhost:27017/mern-auth

# ── Auth ──────────────────────────────────────────────────────────────────────
# ✅ Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ❌ NEVER use a short, guessable, or reused secret in production.
JWT_SECRET=your-jwt-secret-key-change-in-production-min-32-chars

# ── Session ───────────────────────────────────────────────────────────────────
# ✅ Use a separate secret for sessions; do not reuse JWT_SECRET.
SESSION_SECRET=your-session-secret-key-change-in-production-min-32-chars

# ── CORS / Frontend URL ───────────────────────────────────────────────────────
# ✅ Exact frontend origin — no trailing slash, must be HTTPS in production.
CORS_ORIGIN=http://localhost:5173

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
# ✅ Always set to 'production' in deployed environments.
NODE_ENV=development

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Get these from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# ✅ In production use an absolute URL, e.g.:
# GOOGLE_CALLBACK_URL=https://api.your-app.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=/api/auth/google/callback

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# Get these from: https://github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# ✅ In production use an absolute URL, e.g.:
# GITHUB_CALLBACK_URL=https://api.your-app.com/api/auth/github/callback
GITHUB_CALLBACK_URL=/api/auth/github/callback

# ── Frontend environment variables (copy to your frontend .env) ───────────────
# Vite:           VITE_API_URL=http://localhost:5000/api/auth
# Create React App: REACT_APP_API_URL=http://localhost:5000/api/auth
# Next.js:        NEXT_PUBLIC_API_URL=http://localhost:5000/api/auth
